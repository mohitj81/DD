{"pageProps":{"cms":{"about":[{"primary":{"margin":"small","image":{"dimensions":{"width":1920,"height":1080},"alt":null,"copyright":null,"url":"https://images.prismic.io/quarry-house/9ca9c5e2-7a42-4f0c-bae6-4ae9d4be4134_QUARRY_Exterior_final+1.jpg?auto=compress,format&rect=0,0,1920,1080&w=1920&h=1080","id":"YtAVgBEAAB8AXVLu","edit":{"x":0,"y":0,"zoom":1,"background":"#fff"}}},"items":[{}],"id":"image$8b3db49b-8d27-4d34-999a-4ff7ed9da90e","sliceType":"image","sliceLabel":null},{"primary":{"title":"(Introduction)","number":"01","text":[{"type":"paragraph","text":"Each piece of stone I touch is connected to a limitless past, the incomprehensible slow compression of organics layering in prehistoric oceans that rise from the sea, forming earthly topography.","spans":[]}]},"items":[{}],"id":"advanced_text$e674b103-52b9-45db-bf03-d36aa7352b5e","sliceType":"advanced_text","sliceLabel":null},{"primary":{"align":"center","grow":[{"type":"heading6","text":"52/43","spans":[]}],"image2":{"dimensions":{"width":1444,"height":1740},"alt":null,"copyright":null,"url":"https://images.prismic.io/quarry-house/1a8ddcd5-baa1-4238-bd00-4a0dab2fa885_QUARRY_Living+room_final+1+1+%281%29.jpg?auto=compress,format","id":"Y1Z4nREAACEA8nrJ","edit":{"x":0,"y":0,"zoom":1,"background":"#fff"}},"image1":{"dimensions":{"width":1204,"height":1500},"alt":null,"copyright":null,"url":"https://images.prismic.io/quarry-house/4b3c800c-23d5-47c3-a523-d190e31e5252_QUARRY_Store+room+2_final_3+2.jpg?auto=compress,format","id":"Y1Z4zhEAACMA8nuu","edit":{"x":0,"y":0,"zoom":1,"background":"#fff"}}},"items":[{}],"id":"images$eacc7de0-af39-4d51-a85f-5db27557491f","sliceType":"images","sliceLabel":null},{"primary":{"text":"house\norigins"},"items":[{}],"id":"title$432694db-97d2-40b4-8832-8ef5f41d8bab","sliceType":"title","sliceLabel":null},{"primary":{"title":"(Digital Experience)","number":"02","text":[{"type":"paragraph","text":"When we see natural stone extracted from its context, its noble origins are frequently forgotten. \n\nQuarry House is a project years in the making that asked digital creators to forge a substantive connection to natural stone that blurs the separation between source and material.","spans":[]}]},"items":[{}],"id":"advanced_text$8de53900-836d-49f0-bf8d-09e5e84dac65","sliceType":"advanced_text","sliceLabel":null},{"primary":{"margin":"big","image":{"dimensions":{"width":1920,"height":2291},"alt":null,"copyright":null,"url":"https://images.prismic.io/quarry-house/46172bf4-1a93-409c-ad2d-1ead80981ff4_Mask+group+%282%29.png?auto=compress,format&rect=0,0,694,828&w=1920&h=2291","id":"YxmdrxEAACIAKSWJ","edit":{"x":0,"y":0,"zoom":2.7669082125603865,"background":"transparent"}}},"items":[{}],"id":"image$17f30846-40ce-4d00-a5b0-1d3291c6ef41","sliceType":"image","sliceLabel":null},{"primary":{"text":"About\nAriadne"},"items":[{}],"id":"title$e8127fde-3695-4b40-b0d3-8cc75afcf976","sliceType":"title","sliceLabel":null},{"primary":{"title":"(Collection)","number":null,"text":[{"type":"paragraph","text":"Known for his otherworldly stone vessels, Ariadne marks Matthew Fisher’s second collection and first exploration integrating cotton textile knottings into his carved stonework in one-of-a-kind vessels, bowls, and lanterns. \n\nThe collection draws inspiration from ancient mythology and the life of the Cretan Princess Ariadne.","spans":[]}]},"items":[{}],"id":"advanced_text$2a6c4a98-aea2-4a88-8ac7-0d4ce4ab38ce","sliceType":"advanced_text","sliceLabel":null},{"primary":{"align":"top","grow":[{"type":"heading6","text":"66/33","spans":[]}],"image2":{"dimensions":{"width":900,"height":1144},"alt":null,"copyright":null,"url":"https://images.prismic.io/quarry-house/a54895bd-8b61-4fca-ad58-d619606eb81a_Matthew+Fisher_Ardiane+by+Matthew+Fisher_Vessel+4_Photography+by+Michael+Druce_B+1.jpg?auto=compress,format","id":"Y1Z5AhEAACMA8nzC","edit":{"x":0,"y":0,"zoom":1,"background":"#fff"}},"image1":{"dimensions":{"width":1840,"height":1436},"alt":null,"copyright":null,"url":"https: